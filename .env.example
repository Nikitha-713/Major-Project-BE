PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=use_a_long_random_string_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay TEST mode keys (Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
# Only needed if you set up the webhook (any long random text, same value in the Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=

# Billing configuration (never hardcoded in the code)
PLATFORM_FEE_PERCENT=5
SLOT_HOLD_MINUTES=15
INVOICE_PREFIX=INV
